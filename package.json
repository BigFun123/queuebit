{
  "name": "@usermetrics/queuebit",
  "version": "1.0.16",
  "publishConfig": {
    "access": "public"
  },
  "description": "A high performance queue with guaranteed delivery and built-in load balancer. Runs in-process or as a standalone server. Supports browser clients.",
  "main": "src/index.js",
  "types": "src/types.d.ts",
  "browser": "src/client-browser.js",
  "module": "src/client-react.js",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/client-react.js",
      "require": "./src/index.js",
      "browser": "./src/client-browser.js"
    },
    "./client": {
      "types": "./src/types.d.ts",
      "import": "./src/client-react.js",
      "require": "./src/client-node.js"
    },
    "./server": {
      "types": "./src/types.d.ts",
      "import": "./src/server.js",
      "require": "./src/server.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node test/test-harness.js",
    "test:persistence": "node test/test-persistence.js",
    "test:connection": "node test/test-connection-stability.js",
    "start": "node src/server-runner.js",
    "start:debug": "node src/server-runner.js --debug",
    "server": "node src/server-runner.js",
    "auto": "nodemon src/server-runner.js",
    "prepublishOnly": "npm test",
    "build": "pkg . --targets node18-win-x64 --output dist/queuebit-server.exe",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist"
  },
  "keywords": [
    "queue",
    "socket",
    "nats",
    "message-queue",
    "websocket",
    "pubsub",
    "realtime"
  ],
  "author": "Karl Lilje <karl@karllilje.com>",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "pkg": "^5.8.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "src/",
    "docs/",
    "examples/",
    "LICENSE",
    "README.md",
    "start_server.cmd"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bigfun123/queuebit.git"
  },
  "bugs": {
    "url": "https://github.com/bigfun123/queuebit/issues"
  },
  "homepage": "https://github.com/bigfun123/queuebit#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "bin": {
    "queuebit-server": "src/server-runner.js"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "package.json"
    ],
    "outputPath": "dist"
  }
}