{
  "name": "@usermetrics/queuebit",
  "version": "1.0.13",
  "publishConfig": {
    "access": "public"
  },
  "description": "A high performance queue with guaranteed delivery and built-in load balancer. Runs in-process or as a standalone server. Supports browser clients.",
  "main": "src/index.js",
  "types": "src/types.d.ts",
  "browser": "src/client-browser.js",
  "module": "src/client-react.js",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "import": "./src/client-react.js",
      "require": "./src/index.js",
      "browser": "./src/client-browser.js"
    },
    "./client": {
      "types": "./src/types.d.ts",
      "import": "./src/client-react.js",
      "require": "./src/client-node.js"
    },
    "./server": {
      "types": "./src/types.d.ts",
      "require": "./src/server.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node test/test-harness.js",
    "start": "node src/server-runner.js",
    "server": "node src/server-runner.js",
    "auto": "nodemon src/server-runner.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "queue",
    "socket",
    "nats",
    "message-queue",
    "websocket",
    "pubsub",
    "realtime"
  ],
  "author": "Karl Lilje <karl@karllilje.com>",
  "license": "MIT",
  "dependencies": {
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "src/",
    "docs/",
    "examples/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bigfun123/queuebit.git"
  },
  "bugs": {
    "url": "https://github.com/bigfun123/queuebit/issues"
  },
  "homepage": "https://github.com/bigfun123/queuebit#readme",
  "engines": {
    "node": ">=14.0.0"
  }
}
